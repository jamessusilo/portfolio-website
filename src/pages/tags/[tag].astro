---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Tag: ${tag}`}>
  <section class="section">
    <div class="container">
      <h1 class="page-title">Tag: {tag}</h1>
      <div class="list" style="margin-top: 24px;">
        {posts.map((post) => (
          <article class="card">
            <div class="small">{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</div>
            <h2 style="margin: 12px 0 8px; font-family: 'Newsreader', serif;">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <p class="small">{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
