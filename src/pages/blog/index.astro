---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Writing about robotics, embodied AI, and real-world systems.">
  <section class="section">
    <div class="container">
      <h1 class="page-title">Blog</h1>
      <p class="lead">Notes on robotics, control, and deploying real systems.</p>
      <div class="list" style="margin-top: 28px;">
        {posts.map((post) => (
          <article class="card">
            <div class="small">{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</div>
            <h2 style="margin: 12px 0 8px; font-family: 'Newsreader', serif;">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <p class="small">{post.data.description}</p>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px;">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
