---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <div>
        <h1 class="page-title">Welcome to my blog.</h1>
        <p class="lead">
          Hi, I’m James. I’m a Software Engineer at Google DeepMind Robotics. I write about
          anything related to robotics. This blog also serves as my learning notes as I
          explore this vast field.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px;">
        <h2 style="margin: 0;">Latest writing</h2>
        <a class="small" href="/blog/">View all</a>
      </div>
      <div class="list" style="margin-top: 20px;">
        {posts.map((post) => (
          <article class="card">
            <div class="small">{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</div>
            <h3 style="margin: 12px 0 8px;">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h3>
            <p class="small">{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
