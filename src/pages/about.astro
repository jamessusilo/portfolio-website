---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="section">
    <div class="container">
      <h1 class="page-title">About</h1>
      <div class="prose">
        <p>
          I’m James Susilo, a Software Engineer at Google DeepMind Robotics.
        </p>
        <p>
          My work focuses on robotics data and infrastructure for embodied AI systems,
          including the foundations that support faster research iteration and scalable
          robotics training under real-world constraints.
        </p>
        <p>
          Previously, I worked at Meta, Google, and Tesla. I studied at UC Berkeley.
        </p>
        <div class="social-icons">
          <a
            href="https://www.linkedin.com/in/jamessusilo/"
            target="_blank"
            rel="noopener noreferrer me"
            title="LinkedIn"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.473 0 16 .513 16 1.146v13.708c0 .633-.527 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zM4.943 13.5V6.169H2.542V13.5zm-1.2-8.332c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.211 2.4 3.92c0 .694.506 1.248 1.327 1.248m2.401 8.332h2.401V9.409c0-.219.016-.438.08-.595.175-.437.574-.889 1.243-.889.877 0 1.228.67 1.228 1.653V13.5h2.401V9.301c0-2.248-1.2-3.293-2.8-3.293-1.291 0-1.845.712-2.165 1.212h.016v-1.04H6.144c.03.67 0 7.32 0 7.32"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
