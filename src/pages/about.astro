---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="section">
    <div class="container">
      <h1 class="page-title">About</h1>
      <div class="prose">
        <p>
          I’m James Susilo, a software engineer at Google DeepMind Robotics. I work on the
          software and systems that turn research ideas into reliable real-world robotics.
        </p>
        <p>
          This site is a place to write clearly about robotics: what actually works in
          practice, where the sharp edges are, and how to bridge modeling, control, and
          deployment. I care about thoughtful systems engineering as much as algorithmic
          breakthroughs.
        </p>
        <p>
          If you want to chat, you can reach me at <strong>hello@james-susilo.com</strong>
          (placeholder).
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
