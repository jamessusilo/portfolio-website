---
import "../styles/global.css";

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · James Susilo` : "James Susilo";
const pageDescription = description ?? "Robotics engineer writing about embodied AI, manipulation, and real-world systems.";
const pathname = Astro.url.pathname;
const normalizePath = (path) => (path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path);
const currentPath = normalizePath(pathname);
const isActive = (path) => {
  const target = normalizePath(path);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="James Susilo RSS" href="/rss.xml" />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <div class="container">
          <nav class="nav">
            <div class="nav-brand">
              <a class="nav-logo" href="/">James Susilo</a>
            </div>
            <div class="nav-actions">
              <ul class="nav-links">
                <li>
                  <a href="/blog/" class:list={{ active: isActive("/blog") }} aria-current={isActive("/blog") ? "page" : undefined}>Blog</a>
                </li>
                <li>
                  <a href="/about/" class:list={{ active: isActive("/about") }} aria-current={isActive("/about") ? "page" : undefined}>About</a>
                </li>
              </ul>
              <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
                <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="5"></circle>
                  <line x1="12" y1="1" x2="12" y2="3"></line>
                  <line x1="12" y1="21" x2="12" y2="23"></line>
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                  <line x1="1" y1="12" x2="3" y2="12"></line>
                  <line x1="21" y1="12" x2="23" y2="12"></line>
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </div>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <div class="container">
          <div>© {new Date().getFullYear()} James Susilo</div>
        </div>
      </footer>
    </div>
    <script>
      import { initThemeToggle } from "../scripts/theme-toggle.js";
      initThemeToggle();
    </script>
  </body>
</html>
